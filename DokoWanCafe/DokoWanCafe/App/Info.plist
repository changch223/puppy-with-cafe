<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Googleマップアプリの有無を canOpenURL で判定するために必要（経路チューザー機能）。
	     GENERATE_INFOPLIST_FILE=YES と INFOPLIST_FILE を併用すると、
	     このファイルの内容が自動生成Info.plistへマージされる（配列はINFOPLIST_KEY_では表現不可のため）。 -->
	<!-- 対応言語は日本語のみ（App Store Connect の言語判定を明示。ja.lproj は String Catalog から生成される） -->
	<key>CFBundleLocalizations</key>
	<array>
		<string>ja</string>
	</array>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>comgooglemaps</string>
	</array>
</dict>
</plist>
